import java.io.*;
import java.util.Scanner;
public class Armstrong {
    
    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter a number to check whether it is an armstrong number or not: ");
        int num = sc.nextInt();
        if(isArmstrong(num,countDigits(num)))
        {
            System.out.println("The number that you've entered is an armstrong number");
        }
        else System.out.println("The number that you've entered is not an armstrong number");
    }

    static int countDigits(int num){ //using string conversion to count the number of digits in a number 

        return String.valueOf(num).length();
    }

    static boolean isArmstrong(int num, int count)
    {
        int sum=0;
        int temp=num;

        while(temp>0){
            int rem = temp%10;
            sum = sum + (int)Math.pow(rem,count);
            temp = temp/10;
        }
        if(sum==num) return true;
        return false;
    }
}
